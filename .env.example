# Infura Mainnet (production, a activer plus tard)
# INFURA_MAINNET_WS=wss://mainnet.infura.io/ws/v3/COLLEZ_VOTRE_CLE_INFURA

# Cle privee du Wallet A (66 caracteres, commence par 0x)
WALLET_A_PRIVATE_KEY=0xCOLLEZ_VOTRE_CLE_PRIVEE
